# ──────────────────────────────────────────────────────────────────────────────
# Fichier d'exemple de variables d'environnement – Quiz Races de Chiens
# Copiez ce fichier vers .env.local et remplissez vos valeurs.
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de données PostgreSQL ──────────────────────────────────────────────
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
# Exemples :
#   Local        : postgresql://postgres:motdepasse@localhost:5432/quiz_chiens
#   Supabase     : postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#   Neon         : postgresql://[USER]:[PASSWORD]@[HOST]/[DATABASE]?sslmode=require
#   PlanetScale  : mysql://[USER]:[PASSWORD]@[HOST]/[DATABASE]?sslaccept=strict

DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/quiz_chiens"

# ── The Dog API ─────────────────────────────────────────────────────────────
# Clé API gratuite disponible sur https://thedogapi.com/
# Utilisée pour enrichir les fiches races (description, groupe, taille)
# Optionnel : l'application fonctionne sans cette clé

DOG_API_KEY="votre-cle-api-the-dog-api"

# ── Next.js (production) ─────────────────────────────────────────────────────
# URL publique de votre application (nécessaire en production)
NEXTAUTH_URL="https://votre-app.vercel.app"

# Note : Dog CEO API (https://dog.ceo/api) ne nécessite pas de clé API.
